{
  "rules": {
    ".read": false,
    ".write": false,
    "pwa_device_registry": {
      "$device_id": {
        ".read": false,
        ".write": "newData.child('device_id').val() === $device_id && newData.child('secret').val() === 'cfdcwZwdkT8L3EDu-PZdiYEs'",
        ".validate": "newData.hasChildren(['device_id','name','app_version','platform','secret','login_session_id']) && newData.child('platform').val() === 'ios_web'"
      },
      ".read": "query.orderByChild == 'secret' && query.equalTo == 'cfdcwZwdkT8L3EDu-PZdiYEs'",
      ".indexOn": [
        "secret"
      ]
    },
    "pwa_control": {
      "$control_key": {
        ".read": true,
        ".write": false
      }
    },
    "pwa_archive_decisions": {
      "$control_key": {
        "$request_id": {
          ".read": false,
          ".write": "newData.child('secret').val() === 'cfdcwZwdkT8L3EDu-PZdiYEs' && newData.child('request_id').val() === $request_id && newData.child('device_id').isString()",
          ".validate": "newData.hasChildren(['secret','request_id','device_id','kind','created_at_ms'])"
        }
      }
    },
    "pwa_archive_snapshots": {
      "$control_key": {
        ".read": true,
        ".write": false
      }
    },
    "pwa_latest_reports": {
      "$control_key": {
        ".read": true,
        ".write": false
      }
    },
    "pwa_registration_events": {
      "$event_id": {
        ".read": false,
        ".write": "newData.child('secret').val() === 'cfdcwZwdkT8L3EDu-PZdiYEs' && newData.child('device_id').isString() && newData.child('kind').val() === 'device_register'",
        ".validate": "newData.hasChildren(['secret','device_id','kind','name','app_version','platform','login_session_id','created_at_ms']) && newData.child('platform').val() === 'ios_web'"
      },
      ".read": "query.orderByChild == 'secret' && query.equalTo == 'cfdcwZwdkT8L3EDu-PZdiYEs'",
      ".indexOn": [
        "secret"
      ]
    },
    "pwa_registration_receipts": {
      "$device_id": {
        ".read": true,
        ".write": "newData.child('device_id').val() === $device_id && newData.child('secret').val() === 'cfdcwZwdkT8L3EDu-PZdiYEs'",
        ".validate": "newData.hasChildren(['device_id','secret','ack_at_ms','login_session_id'])"
      }
    },
    "pwa_latest_broadcast": {
      "$broadcast_key": {
        ".read": true,
        ".write": "newData.child('secret').val() === 'cfdcwZwdkT8L3EDu-PZdiYEs' && newData.child('kind').val() === 'report_notification'",
        ".validate": "newData.hasChildren(['secret','kind','created_at_ms'])"
      }
    }
  }
}
